# Shared specification and implementation: https://github.com/kinoko34077/devflow/issues/1088
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,scss,html}]
indent_style = space
indent_size = 2

[*.{py,rs}]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
tab_width = 8

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
charset = unset

# EXO/SRT are external interchange files; preserve their original encoding and bytes.
[*.{exo,srt}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
